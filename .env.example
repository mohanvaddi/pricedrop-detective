TELEGRAM_BOT_TOKEN=""

# Local (Docker): postgres://postgres:postgres@localhost:5432/pricedrop
# Production (Supabase): find under Project Settings → Database → Connection string (URI)
DATABASE_URL=""

# Reddit bot (optional — omit to disable)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
REDDIT_USER_AGENT="pricedrop-detective/1.0"

# WebUI JWT (generate a strong random secret)
JWT_SECRET=""

# Scrapers service (API -> scrapers over HTTP). Defaults to http://localhost:5001
# In Docker compose this is set to http://scrapers:5001 automatically.
SCRAPER_URL="http://localhost:5001"
# Port the scrapers service HTTP server listens on (default 5001)
SCRAPER_PORT="5001"
# Cron cadence for the scrapers batch worker (default: every minute)
SCRAPE_CRON="* * * * *"

# Camoufox stealth browser run mode (used for all browser-based scraping):
#   "virtual" (default) -> headed Firefox on an Xvfb virtual display (max stealth)
#   "true"              -> pure headless (lighter; use where Xvfb is unavailable)
#   "false"             -> headed on the real display (local debugging)
CAMOUFOX_HEADLESS="virtual"
# Where the Camoufox browser binary is installed (set in the Docker image).
# Locally, defaults to ~/.cache/camoufox; run `pnpm --filter @pricedrop/scrapers exec camoufox-js fetch`.
CAMOUFOX_INSTALL_DIR="/opt/camoufox"

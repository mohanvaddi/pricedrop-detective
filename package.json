{
  "name": "pricedrop-detective",
  "version": "1.0.0",
  "description": "🚀 Real-time price tracking for your favorite products.",
  "private": true,
  "scripts": {
    "db:generate": "cd shared && drizzle-kit generate",
    "db:migrate": "cd shared && drizzle-kit migrate",
    "db:studio": "cd shared && drizzle-kit studio",
    "dev": "tsx watch server/server.ts",
    "dev:server": "tsx watch server/server.ts",
    "dev:scrapers": "tsx watch scrapers/src/index.ts",
    "scrape:worker": "tsx scrapers/src/worker.ts",
    "recategorize": "tsx scrapers/scripts/recategorize.ts",
    "docs:check": "node scripts/check-docs.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:db": "bash scripts/test-db.sh",
    "test:live": "jest --config jest.config.live.ts",
    "test:all": "bash scripts/test.sh all",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "mohanvaddi",
  "license": "ISC",
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
